{
  "name": "obsidian-line-breaker",
  "version": "0.2.1",
  "description": "Line Breaker will make keeping markdown pretty comfier. One enter press and you’ll be writing the next paragraph, one backspace press and you’ll get rid of trailing spaces.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node tests/run.mjs",
    "check": "npm run build && npm test"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
